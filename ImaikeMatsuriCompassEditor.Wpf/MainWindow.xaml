<Window x:Class="ImaikeMatsuriCompassEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="今池まつり Compass Editor" Width="1250" Height="800" MinWidth="950" MinHeight="600"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="今池まつり Compass Editor" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="2026 タイムテーブル確認・カテゴリ編集" Opacity="0.65" Margin="0,2,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" CornerRadius="4"
                    Background="{DynamicResource PrimaryHueMidBrush}">
                <TextBlock Text="2026" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="再読み込み" Style="{StaticResource MaterialDesignOutlinedButton}" Click="ReloadButton_Click" Margin="0,0,8,0" Padding="16,8"/>
            <Button Content="保存" Style="{StaticResource MaterialDesignRaisedButton}" x:Name="SaveButton" Click="SaveButton_Click" Margin="0,0,8,0" Padding="18,8"/>
            <Button Content="公式タイムテーブル" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OfficialButton_Click" Padding="16,8"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="確認対象" Style="{StaticResource MaterialDesignCardGroupBox}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" materialDesign:HintAssist.Hint="会場名を検索" Margin="0,0,0,10" Padding="8"
                             materialDesign:TextFieldAssist.HasClearButton="True"/>
                    <ComboBox x:Name="VenueComboBox" Grid.Row="1" ItemsSource="{Binding Venues}" SelectedIndex="0"
                              DisplayMemberPath="Name" materialDesign:HintAssist.Hint="会場を選択"
                              SelectionChanged="VenueComboBox_SelectionChanged" Padding="8" VerticalAlignment="Top"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="タイムスケジュール確認" Style="{StaticResource MaterialDesignCardGroupBox}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="ScheduleHeaderText" Text="会場を選択してください。" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="時刻は24時間表記" Opacity="0.6" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="ScheduleDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" SelectionUnit="FullRow" ItemsSource="{Binding CurrentSchedules}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付" Binding="{Binding EventDateText, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="開始" Binding="{Binding StartTimeText, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="終了" Binding="{Binding EndTimeText, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title, Mode=OneWay}" Width="*"/>
                            <DataGridComboBoxColumn Header="カテゴリ" SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}" Width="130"/>
                            <DataGridCheckBoxColumn Header="確認済" Binding="{Binding Verified, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,16,0,0">
            <StatusBarItem x:Name="ConnectionStatus" Content="接続中…"/>
            <Separator/>
            <StatusBarItem Content="カテゴリと確認済は編集後に保存できます" Opacity="0.7"/>
        </StatusBar>
    </Grid>
</Window>
