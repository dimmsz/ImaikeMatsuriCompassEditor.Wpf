<Window x:Class="ImaikeMatsuriCompassEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="今池まつり Compass Editor" Width="1250" Height="800" MinWidth="950" MinHeight="600"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="今池まつり Compass Editor" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="2026 タイムテーブル確認・カテゴリ編集" Opacity="0.65" Margin="0,2,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" CornerRadius="4"
                    Background="{DynamicResource PrimaryHueMidBrush}">
                <TextBlock Text="2026" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Global actions -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="再読み込み" Style="{StaticResource MaterialDesignOutlinedButton}" Click="ReloadButton_Click" Margin="0,0,8,0" Padding="16,8"/>
                <Button Content="保存" Style="{StaticResource MaterialDesignRaisedButton}" x:Name="SaveButton" Click="SaveButton_Click" Margin="0,0,8,0" Padding="20,8"/>
                <Button Content="公式タイムテーブル" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OfficialButton_Click" Padding="16,8"/>
            </StackPanel>
        </DockPanel>

        <!-- Selection toolbar: venue is now the primary selector -->
        <Border Grid.Row="2" Padding="16,12" Margin="0,0,0,16" CornerRadius="6"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="会場" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="VenueComboBox" Grid.Column="1" ItemsSource="{Binding Venues}" DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="会場を選択" SelectionChanged="VenueComboBox_SelectionChanged"
                          Padding="8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="対象件数" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="ScheduleCountText" Grid.Column="4" Text="-" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="時刻は24時間表記（HH:mm）" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Main editor -->
        <GroupBox Grid.Row="3" Header="タイムスケジュール" Style="{StaticResource MaterialDesignCardGroupBox}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ScheduleHeaderText" Text="会場を選択してください。" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <DataGrid x:Name="ScheduleDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          SelectionMode="Single" SelectionUnit="FullRow" ItemsSource="{Binding CurrentSchedules}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付" Binding="{Binding EventDateText, Mode=OneWay}" Width="120"/>
                        <DataGridTextColumn Header="開始" Binding="{Binding StartTimeText, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="終了" Binding="{Binding EndTimeText, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="タイトル" Binding="{Binding Title, Mode=OneWay}" Width="*"/>
                        <DataGridComboBoxColumn Header="カテゴリ" SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}" Width="130"/>
                        <DataGridCheckBoxColumn Header="確認済" Binding="{Binding Verified, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="4" Margin="0,16,0,0">
            <StatusBarItem x:Name="ConnectionStatus" Content="接続中…"/>
            <Separator/>
            <StatusBarItem Content="会場を選択 → タイムテーブル確認 → カテゴリ設定 → 保存" Opacity="0.7"/>
        </StatusBar>
    </Grid>
</Window>
