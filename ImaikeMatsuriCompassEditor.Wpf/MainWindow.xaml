<Window x:Class="ImaikeMatsuriCompassEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今池まつり Compass Editor" Width="1250" Height="800" MinWidth="950" MinHeight="600">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="今池まつり Compass Editor" FontSize="26" FontWeight="Bold"/>
            <TextBlock DockPanel.Dock="Right" Text="2026" FontSize="18" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="再読み込み" Click="ReloadButton_Click" Padding="18,8" Margin="0,0,8,0"/>
            <Button Content="保存" x:Name="SaveButton" Click="SaveButton_Click" Padding="18,8" Margin="0,0,8,0"/>
            <Button Content="公式タイムテーブルを開く" Click="OfficialButton_Click" Padding="18,8"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="確認対象">
                <ListBox x:Name="VenueListBox" Margin="8" DisplayMemberPath="Name" SelectionChanged="VenueListBox_SelectionChanged"/>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="タイムスケジュール確認">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ScheduleHeaderText" Text="会場を選択してください。" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="ScheduleDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" ItemsSource="{Binding CurrentSchedules}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付" Binding="{Binding EventDate, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="開始" Binding="{Binding StartTime, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="終了" Binding="{Binding EndTime, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title, Mode=OneWay}" Width="*"/>
                            <DataGridComboBoxColumn Header="カテゴリ" SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}" Width="130"/>
                            <DataGridCheckBoxColumn Header="確認済" Binding="{Binding Verified, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>
        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem x:Name="ConnectionStatus" Content="接続中…"/>
            <StatusBarItem Content="カテゴリと確認済は編集後に保存できます" Margin="20,0,0,0"/>
        </StatusBar>
    </Grid>
</Window>
