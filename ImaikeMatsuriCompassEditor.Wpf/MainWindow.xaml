<Window x:Class="ImaikeMatsuriCompassEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="今池まつり Compass Editor" Width="1250" Height="980" MinWidth="950" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="330"/>
            <RowDefinition Height="2*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="今池まつり Compass Editor" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="2026 タイムテーブル確認・カテゴリ・タグ編集" Opacity="0.65" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button Content="再読み込み" Style="{StaticResource MaterialDesignOutlinedButton}" Click="ReloadButton_Click" Margin="0,0,8,0" Padding="16,8"/>
                <Button Content="保存" Style="{StaticResource MaterialDesignRaisedButton}" x:Name="SaveButton" Click="SaveButton_Click" Margin="0,0,8,0" Padding="20,8"/>
                <Button Content="公式タイムテーブル" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OfficialButton_Click" Padding="16,8"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="タイムスケジュール" Style="{StaticResource MaterialDesignCardGroupBox}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="VenueComboBox" Grid.Column="0" ItemsSource="{Binding Venues}" DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="会場を選択" SelectionChanged="VenueComboBox_SelectionChanged"
                              Padding="8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="対象件数" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ScheduleCountText" Grid.Column="3" Text="-" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="時刻は24時間表記（HH:mm）" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <DataGrid x:Name="ScheduleDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="ScheduleDataGrid_SelectionChanged"
                          ItemsSource="{Binding CurrentSchedules}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付" Binding="{Binding EventDateText, Mode=OneWay}" Width="120"/>
                        <DataGridTextColumn Header="開始" Binding="{Binding StartTimeText, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="終了" Binding="{Binding EndTimeText, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="タイトル" Binding="{Binding Title, Mode=OneWay}" Width="*"/>
                        <DataGridComboBoxColumn Header="カテゴリ" SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}" Width="130"/>
                        <DataGridCheckBoxColumn Header="確認済" Binding="{Binding Verified, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16" CornerRadius="6"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid DataContext="{Binding SelectedSchedule}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="編集" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid Grid.Row="1" IsEnabled="{Binding ., FallbackValue=False}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="日付" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding EventDateText, TargetNullValue=—}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="開始" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding StartTimeText, TargetNullValue=—}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="終了" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding EndTimeText, TargetNullValue=—}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="タイトル" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title, TargetNullValue=イベントを選択してください}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="カテゴリ" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                    <CheckBox Grid.Column="5" Content="確認済" IsChecked="{Binding Verified, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="タグ" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,8,10,0"/>
                    <StackPanel Grid.Column="1">
                        <ComboBox x:Name="TagComboBox"
                                  ItemsSource="{Binding DataContext.AvailableTags, RelativeSource={RelativeSource AncestorType=Window}}"
                                  materialDesign:HintAssist.Hint="追加するタグを選択"
                                  Padding="6"/>
                        <Button Content="タグを追加" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="AddTagButton_Click" Margin="0,8,0,0" Padding="12,6"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="選択中" FontWeight="SemiBold" VerticalAlignment="Top" Margin="20,8,10,0"/>
                    <ScrollViewer Grid.Column="3" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DataContext.SelectedTags, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="12"
                                            Background="{DynamicResource PrimaryHueMidBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>
                                            <Button Content="×" Tag="{Binding}" Click="RemoveTagButton_Click"
                                                    Margin="6,0,0,0" Padding="3,0" MinWidth="22" MinHeight="22"
                                                    Foreground="White" Background="Transparent" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <StatusBar Grid.Row="3" Margin="0,16,0,0">
            <StatusBarItem x:Name="ConnectionStatus" Content="接続中…"/>
            <Separator/>
            <StatusBarItem Content="会場を選択 → イベントを選択 → カテゴリ・タグ編集 → 保存" Opacity="0.7"/>
        </StatusBar>
    </Grid>
</Window>
