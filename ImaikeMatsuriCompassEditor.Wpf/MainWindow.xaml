<Window x:Class="ImaikeMatsuriCompassEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="今池まつり Compass Editor" Width="1250" Height="980" MinWidth="950" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="330"/>
            <RowDefinition Height="2*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="今池まつり Compass Editor" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="2026 タイムテーブル確認・ジャンル・タグ編集" Opacity="0.65" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button Content="再読み込み" Style="{StaticResource MaterialDesignOutlinedButton}" Click="ReloadButton_Click" Margin="0,0,8,0" Padding="16,8"/>
                <Button Content="保存" Style="{StaticResource MaterialDesignRaisedButton}" x:Name="SaveButton" Click="SaveButton_Click" Margin="0,0,8,0" Padding="20,8"/>
                <Button Content="公式タイムテーブル" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OfficialButton_Click" Padding="16,8"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="タイムスケジュール" Style="{StaticResource MaterialDesignCardGroupBox}">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="VenueComboBox" Grid.Column="0" ItemsSource="{Binding Venues}" DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="会場を選択" SelectionChanged="VenueComboBox_SelectionChanged" Padding="8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="対象件数" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ScheduleCountText" Grid.Column="3" Text="-" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="時刻は24時間表記（HH:mm）" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <DataGrid x:Name="ScheduleDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                          PreviewMouseLeftButtonDown="ScheduleDataGrid_PreviewMouseLeftButtonDown"
                          ItemsSource="{Binding CurrentSchedules}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付" Binding="{Binding EventDateText, Mode=OneWay}" Width="120"/>
                        <DataGridTextColumn Header="開始" Binding="{Binding StartTimeText, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="終了" Binding="{Binding EndTimeText, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="タイトル" Binding="{Binding Title, Mode=OneWay}" Width="*"/>
                        <DataGridComboBoxColumn Header="ジャンル" SelectedItemBinding="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.Genres, RelativeSource={RelativeSource AncestorType=Window}}" Width="110"/>
                        <DataGridCheckBoxColumn Header="確認済" Binding="{Binding Verified, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="18" CornerRadius="8"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 編集ヘッダー -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="イベント情報" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="選択したイベントのジャンル・タグを設定します" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="EditVerifiedCheckBox" Grid.Column="1" Content="確認済み"
                              FontWeight="SemiBold" VerticalAlignment="Center"
                              Checked="EditVerifiedCheckBox_Changed" Unchecked="EditVerifiedCheckBox_Changed"/>
                </Grid>

                <!-- 選択イベント -->
                <Border Grid.Row="1" Padding="12" CornerRadius="6"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                        Background="{DynamicResource MaterialDesignPaper}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="EditTitleText" Grid.Row="0" Text="イベントを選択してください"
                                   FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日付" Opacity="0.6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EditEventDateText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="開始" Opacity="0.6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EditStartTimeText" Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="終了" Opacity="0.6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EditEndTimeText" Grid.Column="7" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ジャンル -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="ジャンル" FontWeight="SemiBold"/>
                        <TextBlock Text="大分類" FontSize="11" Opacity="0.55"/>
                    </StackPanel>
                    <ComboBox x:Name="EditGenreComboBox" Grid.Column="1" ItemsSource="{Binding Genres}"
                              Padding="8" VerticalAlignment="Center"
                              SelectionChanged="EditGenreComboBox_SelectionChanged"/>
                    <TextBlock Grid.Column="2" Text="音楽 / ダンス / ステージ / その他 から1つ選択"
                               VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.5" FontSize="12"/>
                </Grid>

                <!-- タグ -->
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="タグ" FontWeight="SemiBold"/>
                        <TextBlock Text="検索の手がかり" FontSize="11" Opacity="0.55"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ComboBox x:Name="TagComboBox" ItemsSource="{Binding AvailableTags}"
                                  materialDesign:HintAssist.Hint="追加するタグを選択" Padding="8"/>
                        <Button Content="＋ タグを追加" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="AddTagButton_Click" Margin="0,7,0,0" Padding="12,6"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="設定済み" FontWeight="SemiBold"
                               VerticalAlignment="Top" Margin="22,8,12,0"/>
                    <ScrollViewer Grid.Column="3" MaxHeight="100" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="9,5" CornerRadius="14"
                                            Background="{DynamicResource PrimaryHueMidBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>
                                            <Button Content="×" Tag="{Binding}" Click="RemoveTagButton_Click"
                                                    Margin="6,0,0,0" Padding="3,0" MinWidth="22" MinHeight="22"
                                                    Foreground="White" Background="Transparent" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <StatusBar Grid.Row="3" Margin="0,16,0,0">
            <StatusBarItem x:Name="ConnectionStatus" Content="接続中…"/><Separator/>
            <StatusBarItem Content="会場を選択 → イベントを選択 → ジャンル・タグ編集 → 確認済みにして保存" Opacity="0.7"/>
        </StatusBar>
    </Grid>
</Window>
