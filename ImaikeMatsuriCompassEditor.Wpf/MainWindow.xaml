<Window x:Class="ImaikeMatsuriCompassEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今池まつり Compass Editor"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="今池まつり Compass Editor" FontSize="26" FontWeight="Bold" />
            <TextBlock DockPanel.Dock="Right" Text="2026" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="会場一覧" Padding="18,8" Margin="0,0,8,0" />
            <Button Content="タイムスケジュール" Padding="18,8" Margin="0,0,8,0" />
            <Button Content="公式情報確認" Padding="18,8" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="確認対象">
                <ListBox Margin="8">
                    <ListBoxItem Content="今池ガスホール" />
                    <ListBoxItem Content="ストリートコーナーパラダイス" />
                    <ListBoxItem Content="東南会場" />
                    <ListBoxItem Content="一本裏会場" />
                    <ListBoxItem Content="十六広場" />
                    <ListBoxItem Content="西南会場" />
                    <ListBoxItem Content="Imaike Park会場" />
                    <ListBoxItem Content="ノースアイランド" />
                    <ListBoxItem Content="4丁目Pit" />
                    <ListBoxItem Content="下町ネバーランド" />
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="タイムスケジュール確認">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ここにSupabaseから取得したスケジュールを表示します。" FontSize="16" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付" Binding="{Binding EventDate}" Width="110" />
                            <DataGridTextColumn Header="開始" Binding="{Binding StartTime}" Width="80" />
                            <DataGridTextColumn Header="終了" Binding="{Binding EndTime}" Width="80" />
                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="130" />
                            <DataGridCheckBoxColumn Header="確認済" Binding="{Binding Verified}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem Content="未接続" />
            <StatusBarItem Content="公式情報との照合用エディター" />
        </StatusBar>
    </Grid>
</Window>
